# OpenBucket — standalone configuration.
# Copy to `.env` and fill in the secrets. The app validates these on boot and
# REFUSES TO START if anything is missing or malformed.

# --- runtime ---
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# --- admin auth ---
# Signs admin JWTs. Use a long random value (>= 32 chars): `openssl rand -hex 32`.
JWT_SECRET=REPLACE_ME
ADMIN_USERNAME=admin
# argon2id hash of the admin password — generate one with:
#   npx @openbucket/nestjs hash 'your-admin-password'
ADMIN_PASSWORD_HASH=REPLACE_ME

# --- S3 root credentials (SigV4) ---
# ACCESS_KEY_ID: 16-32 UPPERCASE alphanumerics.  SECRET: >= 32 chars.
ROOT_ACCESS_KEY_ID=AKIALOCALDEV000000
ROOT_SECRET_ACCESS_KEY=REPLACE_ME

# --- S3 options ---
OPENBUCKET_REGION=us-east-1
