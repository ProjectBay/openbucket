# OpenBucket embedded in a NestJS app — example configuration.
# Copy to `.env` and fill in the secrets. The module validates these on boot.
#
#   cp .env.example .env
#   npx @openbucket/nestjs hash 'choose-a-strong-password'   # → OB_ADMIN_HASH
#   openssl rand -hex 32   # → OB_JWT_SECRET
#   openssl rand -hex 32   # → OB_SECRET_ACCESS_KEY

# argon2id hash of the admin console password.
# Generate with:  npx @openbucket/nestjs hash 'your-admin-password'
OB_ADMIN_HASH=REPLACE_ME

# Signs admin JWTs. Use a long random value (>= 32 chars): `openssl rand -hex 32`.
OB_JWT_SECRET=REPLACE_ME

# S3 root credentials (SigV4).
# ACCESS_KEY_ID: 16-32 UPPERCASE alphanumerics.  SECRET: >= 32 chars.
OB_ACCESS_KEY_ID=AKIALOCALDEV000000
OB_SECRET_ACCESS_KEY=REPLACE_ME
