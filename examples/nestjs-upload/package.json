{
  "name": "openbucket-example-nestjs-upload",
  "version": "0.0.0",
  "private": true,
  "description": "Embed the OpenBucket S3-compatible object store directly in a NestJS app.",
  "license": "MIT",
  "scripts": {
    "start": "node --watch --env-file=.env -r ts-node/register src/main.ts",
    "start:once": "node --env-file=.env -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@openbucket/nestjs": "^0.1.0-alpha.19",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
