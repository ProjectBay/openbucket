{
  "name": "nestjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/nestjs/src",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/nestjs",
        "main": "libs/nestjs/src/index.ts",
        "tsConfig": "libs/nestjs/tsconfig.lib.json",
        "assets": ["README.md"]
      }
    },
    "bundle-spa": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/libs/nestjs/assets/spa"],
      "dependsOn": ["build"],
      "options": {
        "command": "node scripts/copy-spa.mjs"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/nestjs"],
      "options": {
        "jestConfig": "libs/nestjs/jest.config.ts"
      }
    }
  },
  "tags": []
}
