{
  "name": "@openbucket/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "orm": "mikro-orm --config=../../libs/nestjs/src/lib/mikro-orm.config.ts",
    "orm:migration:create": "npm run orm -- migration:create",
    "orm:migration:up": "npm run orm -- migration:up",
    "orm:migration:list": "npm run orm -- migration:list",
    "orm:schema:fresh": "npm run orm -- schema:fresh"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": ["../../libs/nestjs/src/lib/mikro-orm.config.ts"]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/lib-storage": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@mikro-orm/libsql": "^6.6.14",
    "@mikro-orm/core": "^6.6.14",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@openbucket/nestjs": "0.1.0-alpha.20",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cron-parser": "^5.6.1",
    "express": "5.2.1",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.3.0",
    "image-size": "^1.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "sharp": "^0.35.3",
    "uuid": "^11.1.1",
    "zod": "4.4.3"
  }
