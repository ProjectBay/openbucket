{
  "name": "@openbucket/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "orm": "mikro-orm --config=../../libs/nestjs/src/lib/mikro-orm.config.ts",
    "orm:migration:create": "npm run orm -- migration:create",
    "orm:migration:up": "npm run orm -- migration:up",
    "orm:migration:list": "npm run orm -- migration:list",
    "orm:schema:fresh": "npm run orm -- schema:fresh"
  },
  "mikro-orm": {
    "useTsNode": true,
    "configPaths": ["../../libs/nestjs/src/lib/mikro-orm.config.ts"]
  },
  "dependencies": {
    "@mikro-orm/better-sqlite": "^6.6.14",
    "@mikro-orm/core": "^7.1.5",
    "@mikro-orm/migrations": "^6.6.14",
    "@mikro-orm/nestjs": "^6.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@openbucket/nestjs": "0.1.0",
    "argon2": "^0.41.1",
    "express": "5.2.1",
    "fast-xml-parser": "^4.5.6",
    "helmet": "^8.2.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "uuid": "^10.0.0",
    "zod": "4.3.6"
  }
}
