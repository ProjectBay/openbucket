# OpenBucket — standalone configuration.
# Copy to `.env` and fill in the secrets. The app validates these on boot and
# REFUSES TO START if anything is missing or malformed.

# --- runtime ---
NODE_ENV=production
PORT=9000
LOG_LEVEL=info

# --- persistence ---
# Directory for the SQLite metadata DB, blob payloads, and the generated sse.key.
# In Docker this is the mounted volume (/data); locally use an absolute path.
DATA_DIR=/data

# --- admin auth ---
# Signs admin JWTs. Use a long random value (>= 32 chars), e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ADMIN_USERNAME=admin
# argon2id hash of the admin password — generate with:
#   node scripts/hash-password.mjs 'your-admin-password'
ADMIN_PASSWORD_HASH=
# Optional token lifetimes (seconds).
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- S3 root credentials (SigV4) ---
# ACCESS_KEY_ID: 16-32 uppercase alphanumerics. SECRET: >= 32 chars.
ROOT_ACCESS_KEY_ID=AKIAEXAMPLE000000000
ROOT_SECRET_ACCESS_KEY=change-me-to-a-random-secret-at-least-32-chars

# --- S3 options ---
OPENBUCKET_REGION=us-east-1
# Optional DNS-safe hostname clients use to reach this store.
# OPENBUCKET_ENDPOINT=storage.example.com
# Optional at-rest encryption key (base64 of exactly 32 bytes). If unset, a key
# is generated and persisted to <DATA_DIR>/sse.key on first boot.
# OPENBUCKET_SSE_KEY=

# --- limits (optional) ---
# MAX_OBJECT_SIZE_MB=5120000
# MAX_MULTIPART_PARTS=10000
# MULTIPART_TTL_HOURS=24

# --- usage analytics rollup (optional, STORY-1102) ---
# How often the dashboard usage-rollup samples storage + drains request metrics
# (ms, floor 60000). Retention prunes sample rows older than USAGE_RETENTION_DAYS.
# USAGE_ROLLUP_INTERVAL_MS=900000
# USAGE_RETENTION_DAYS=90

# --- object-event webhooks (optional, STORY-0801) ---
# Setting WEBHOOK_URL enables durable, HMAC-signed delivery of object events
# (object.created / object.deleted / multipart.completed) to your endpoint. The
# URL must be https unless the host is loopback; WEBHOOK_SECRET is then REQUIRED
# and must be strong (>= 32 chars) — the app refuses to boot otherwise.
# WEBHOOK_URL=https://example.com/hooks/openbucket
# WEBHOOK_SECRET=change-me-to-a-random-secret-at-least-32-chars
# Comma-separated event filter (default: all three).
# WEBHOOK_EVENTS=object.created,object.deleted,multipart.completed
# Delivery tuning (defaults shown).
# WEBHOOK_MAX_ATTEMPTS=8
# WEBHOOK_TIMEOUT_MS=5000
# WEBHOOK_POLL_MS=15000

# --- async replication to an external S3 target (optional, STORY-0900) ---
# Set OB_REPLICATION_ENABLED=true to asynchronously mirror every object PUT/DELETE
# to an external S3-compatible bucket (AWS S3 / Cloudflare R2 / Backblaze B2 / MinIO)
# via a durable transactional outbox + background drain worker (per-key ordering,
# last-writer-wins coalescing, exponential backoff, dead-letter cap). When enabled,
# OB_REPLICATION_BUCKET and both credentials are REQUIRED (a partial config refuses
# to boot). The worker sends object PLAINTEXT, so an http:// endpoint warns at boot.
# OB_REPLICATION_ENABLED=false
# OB_REPLICATION_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com  # omit for real AWS S3
# OB_REPLICATION_REGION=us-east-1
# OB_REPLICATION_BUCKET=my-remote-mirror
# OB_REPLICATION_ACCESS_KEY_ID=
# OB_REPLICATION_SECRET_ACCESS_KEY=
# OB_REPLICATION_FORCE_PATH_STYLE=true       # true for MinIO/S3-compat; false for AWS
# Drain tuning (defaults shown).
# OB_REPLICATION_MAX_ATTEMPTS=12
# OB_REPLICATION_DRAIN_INTERVAL_MS=5000
# OB_REPLICATION_BATCH_KEYS=50
# OB_REPLICATION_LARGE_OBJECT_THRESHOLD_BYTES=67108864

# --- shutdown (optional) ---
# SHUTDOWN_DRAIN_MS=30000
