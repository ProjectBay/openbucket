# compiled output
dist
tmp
out-tsc

# MikroORM TsMorphMetadataProvider cache (default ./temp)
temp

# Local dev data (DATA_DIR): SQLite DB + blob payloads + sse.key. Never commit.
/.dev-data

# Angular CLI build cache
/.angular/cache

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data

.claude/worktrees
# Per-developer Claude Code overlay (local paths, personal permissions) — not shared.
.claude/settings.local.json
.nx/polygraph
.nx/self-healing

# Stray local artifact — a generated docs archive, not source. Ignored so it is
# never accidentally committed (also excluded from the Docker build context).
docs.zip